DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# Mastra Observability — https://projects.mastra.ai
# Access token and project id wired up automatically when you run
# `mastra init` / `create-mastra` with Observability enabled. Optional —
# MastraPlatformExporter only sends events if MASTRA_PLATFORM_ACCESS_TOKEN is set.
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=
