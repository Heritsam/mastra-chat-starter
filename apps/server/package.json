    "@mastra/hono": "^1.5.5",
    "@mastra/libsql": "^1.15.0",
    "@mastra/memory": "^1.22.1",
    "@mastra/pg": "^1.15.1",
    "ai": "^7.0.14",
    "dotenv": "catalog:",
