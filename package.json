{
  "name": "mastra-chat-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.4",
      "lucide-react": "^1.21.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "dev:studio": "turbo run dev -F studio",
    "db:push": "turbo run db:push -F @repo/db",
    "db:studio": "turbo run db:studio -F @repo/db",
    "db:generate": "turbo run db:generate -F @repo/db",
    "db:migrate": "turbo run db:migrate -F @repo/db",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@repo/env": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.8",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "catalog:",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.10"
}
